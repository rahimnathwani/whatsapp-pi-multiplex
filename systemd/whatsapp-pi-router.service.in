[Unit]
Description=whatsapp-pi-multiplex router
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=whatsapp-router
Group=whatsapp-pi
UMask=0007
RuntimeDirectory=whatsapp-pi
RuntimeDirectoryMode=0750
StateDirectory=whatsapp-pi-router
StateDirectoryMode=0700
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=WHATSAPP_PI_ROUTER_CONFIG=/etc/whatsapp-pi-router/config.json
ExecStart=/usr/bin/env whatsapp-pi-multiplex
Restart=on-failure
RestartSec=5
LimitNOFILE=128
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/whatsapp-pi /var/lib/whatsapp-pi-router
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
