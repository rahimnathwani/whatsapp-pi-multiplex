{
  "name": "whatsapp-pi-multiplex",
  "version": "0.1.0",
  "type": "module",
  "description": "Multiplex-capable WhatsApp integration extension for Pi (based on whatsapp-pi)",
  "main": "whatsapp-pi.ts",
  "bin": {
    "whatsapp-pi-multiplex": "dist/src/multiplex/router-main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahimnathwani/whatsapp-pi-multiplex.git"
  },
  "bugs": {
    "url": "https://github.com/rahimnathwani/whatsapp-pi-multiplex/issues"
  },
  "homepage": "https://github.com/rahimnathwani/whatsapp-pi-multiplex#readme",
  "files": [
    "whatsapp-pi.ts",
    "src",
    "dist",
    "config",
    "scripts/setup-multiplex-users.sh",
    "scripts/provision-multiplex-credential.py",
    "scripts/whatsapp-pi-multiplex-client.sh",
    "scripts/build-whisper-cli.sh",
    "scripts/build-whisper-cli.ps1",
    "systemd/whatsapp-pi-router.service.in",
    "systemd/whatsapp-pi-multiplex-client@.service.in",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "whatsapp",
    "baileys",
    "agent"
  ],
  "author": "Rahim Nathwani (based on whatsapp-pi by Rapha Castelloes)",
  "license": "MIT",
  "scripts": {
    "lint": "eslint whatsapp-pi.ts \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:router": "tsc -p tsconfig.router.json",
    "prepack": "npm run build:router"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.27.10",
    "baileys": "^6.7.21",
    "ffmpeg-static": "^5.3.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "whisper-cpp-node": "^0.2.12"
  },
  "optionalDependencies": {
    "@llamaindex/liteparse": "^1.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "^20.11.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "pi": {
    "extensions": [
      "./whatsapp-pi.ts"
    ],
    "image": "https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg"
  }
}
